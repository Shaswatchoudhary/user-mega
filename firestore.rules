rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only users can write their own data
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- WORKERS ---
    match /workers/{workerId} {
      // Authenticated users can see real-time workers on map
      allow read: if isAuthenticated();
      // Workers update their own location/availability
      allow update: if isAuthenticated() && request.auth.uid == workerId;
      // Admin/System creates workers
      allow create: if isAuthenticated(); 
    }

    // --- BOOKINGS ---
    match /bookings/{bookingId} {
      // Only parties involved can see/update the booking
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.workerId == request.auth.uid
      );
      
      // User creates a pending booking
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
        
      // Status updates
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.workerId == request.auth.uid
      );
    }
  }
}
