rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Workers: Admin Panel needs to read without Auth, but write requires Auth
    match /workers/{workerId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }

    // 2. Bookings: Admin Panel needs to read details, write requires Auth
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Issues & Support Tickets: Open access for submission and Admin viewing
    match /issues/{issueId} {
      allow read, write: if true;
    }
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    // 4. Users & Notifications: Secured using recursive wildcards
    // This allows the user to access their doc AND any sub-collection (like notifications)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 5. Products: Publicly viewable, but only staff/auth can modify
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 6. Categories & Config: Publicly viewable
    match /categories/{categoryId} {
      allow read: if true;
    }
    match /app_config/{configId} {
      allow read: if true;
    }
  }
}
